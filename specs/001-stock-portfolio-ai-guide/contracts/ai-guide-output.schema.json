{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-guide-output.schema.json",
  "title": "GuideContent",
  "description": "AI 공급자가 반환해야 하는 가이드 구조 (FR-017). guide_request.content(JSONB)에 그대로 저장된다. 면책 문구는 AI가 아니라 화면이 고정 문구로 붙인다. 2026-11-05 확장: supplyDemand·issues·overall 추가(이전 기록 호환을 위해 required 아님). issues의 sourceUrl은 실제 웹 검색 결과에 있는 것만 저장된다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "diagnosis",
    "action",
    "rationale",
    "risks"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "description": "최근 주가 흐름 분석 요약",
      "minLength": 1,
      "maxLength": 1500
    },
    "diagnosis": {
      "type": "string",
      "description": "사용자 보유 상황(평단가 대비 위치, 수익률) 진단",
      "minLength": 1,
      "maxLength": 1500
    },
    "supplyDemand": {
      "type": "string",
      "description": "거래량·투자자별 순매수·외국인 보유 비율·공매도 비중으로 본 수급 분석",
      "minLength": 1,
      "maxLength": 1500
    },
    "issues": {
      "type": "array",
      "description": "웹 검색으로 확인한 국내외 이슈. 웹 검색 미지원 공급자는 빈 배열",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "summary",
          "impact",
          "sourceUrl"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "impact": {
            "type": "string",
            "enum": [
              "POSITIVE",
              "NEGATIVE",
              "NEUTRAL"
            ]
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "maxLength": 500
          },
          "sourceTitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "publishedDate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          }
        }
      }
    },
    "overall": {
      "type": "string",
      "description": "기술적 흐름·수급·이슈·보유 상황을 묶은 종합 판단",
      "minLength": 1,
      "maxLength": 1500
    },
    "action": {
      "type": "string",
      "enum": [
        "HOLD",
        "BUY_MORE",
        "PARTIAL_SELL",
        "SELL",
        "WATCH"
      ],
      "description": "행동 가이드 분류"
    },
    "rationale": {
      "type": "string",
      "description": "행동 가이드의 근거",
      "minLength": 1,
      "maxLength": 2000
    },
    "risks": {
      "type": "array",
      "description": "주요 위험 요인",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  }
}
