# AES-256 마스터 키 (Base64 32바이트): openssl rand -base64 32
APP_CRYPTO_KEY=
# 토스증권 Open API (시세 연동용 운영 설정). WTS 설정 > Open API에서 발급하고 서버 IP를 허용 목록에 등록한다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_BASE_URL=https://openapi.tossinvest.com
# PostgreSQL
POSTGRES_DB=stock
POSTGRES_USER=stock
