# AES-256 마스터 키 (Base64 32바이트): openssl rand -base64 32
APP_CRYPTO_KEY=
# 토스증권 Open API (시세 연동용 운영 설정). WTS 설정 > Open API에서 발급하고 서버 IP를 허용 목록에 등록한다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_BASE_URL=https://openapi.tossinvest.com
# PostgreSQL
POSTGRES_DB=stock
POSTGRES_USER=stock
POSTGRES_PASSWORD=
# 카카오 로그인 (developers.kakao.com > 내 애플리케이션). Redirect URI: {서비스 주소}/login/oauth2/code/kakao
KAKAO_CLIENT_ID=
# 보안 > Client Secret을 켠 경우
KAKAO_CLIENT_SECRET=
# 앱 키 > 어드민 키 (회원 탈퇴 시 카카오 연결 해제용, 외부 노출 금지)
KAKAO_ADMIN_KEY=
# 관리자 카카오 회원번호(쉼표 구분). 관리자만 AI 설정 화면을 보고, 등록한 AI 키를 모든 사용자가 가이드에 쓴다.
# 회원번호는 로그인 후 app_user.kakao_id에서 확인한다. 비어 있으면 관리자가 없다.
ADMIN_KAKAO_IDS=
# 미국 지수·WTI·VIX(FRED) API 키: https://fred.stlouisfed.org/docs/api/api_key.html (비우면 미국 지표 갱신 안 함)
FRED_API_KEY=
