# AES-256 마스터 키 (Base64 32바이트): openssl rand -base64 32
APP_CRYPTO_KEY=
# 토스증권 Open API (시세 연동용 운영 설정). WTS 설정 > Open API에서 발급하고 서버 IP를 허용 목록에 등록한다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_BASE_URL=https://openapi.tossinvest.com
# PostgreSQL
POSTGRES_DB=stock
POSTGRES_USER=stock
POSTGRES_PASSWORD=
# 카카오 로그인 (developers.kakao.com > 내 애플리케이션). Redirect URI: {서비스 주소}/login/oauth2/code/kakao
KAKAO_CLIENT_ID=
# 보안 > Client Secret을 켠 경우
KAKAO_CLIENT_SECRET=
# 앱 키 > 어드민 키 (회원 탈퇴 시 카카오 연결 해제용, 외부 노출 금지)
KAKAO_ADMIN_KEY=
